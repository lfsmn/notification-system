{
    "openapi": "3.1.2",
    "info": {
        "title": "Notification System",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://notification-system.test/api"
        }
    ],
    "paths": {
        "/v1/health": {
            "get": {
                "operationId": "v1.health",
                "description": "Checks the database and Redis. Returns 200 when every dependency is up, 503 otherwise.",
                "summary": "Health check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/metrics": {
            "get": {
                "operationId": "v1.metrics",
                "tags": [
                    "Metrics"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "generated_at": {
                                            "type": "string"
                                        },
                                        "window_minutes": {
                                            "type": "integer",
                                            "const": 60
                                        },
                                        "queue_depth": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "backlog": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "channels": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "generated_at",
                                        "window_minutes",
                                        "queue_depth",
                                        "backlog",
                                        "channels"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/notifications": {
            "post": {
                "operationId": "notification.store",
                "tags": [
                    "Notification"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreNotificationRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "get": {
                "operationId": "notification.index",
                "tags": [
                    "Notification"
                ],
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "$ref": "#/components/schemas/NotificationStatus"
                        }
                    },
                    {
                        "name": "channel",
                        "in": "query",
                        "schema": {
                            "$ref": "#/components/schemas/Channel"
                        }
                    },
                    {
                        "name": "batch_id",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated set of `NotificationResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/NotificationResource"
                                            }
                                        },
                                        "links": {
                                            "type": "object",
                                            "properties": {
                                                "first": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "last": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "prev": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "next": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "first",
                                                "last",
                                                "prev",
                                                "next"
                                            ]
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "from": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "minimum": 1
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "links": {
                                                    "type": "array",
                                                    "description": "Generated paginator links.",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": [
                                                                    "string",
                                                                    "null"
                                                                ]
                                                            },
                                                            "label": {
                                                                "type": "string"
                                                            },
                                                            "active": {
                                                                "type": "boolean"
                                                            }
                                                        },
                                                        "required": [
                                                            "url",
                                                            "label",
                                                            "active"
                                                        ]
                                                    }
                                                },
                                                "path": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Base path for paginator generated URLs."
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "description": "Number of items shown per page.",
                                                    "minimum": 0
                                                },
                                                "to": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "Number of the last item in the slice.",
                                                    "minimum": 1
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "description": "Total number of items being paginated.",
                                                    "minimum": 0
                                                }
                                            },
                                            "required": [
                                                "current_page",
                                                "from",
                                                "last_page",
                                                "links",
                                                "path",
                                                "per_page",
                                                "to",
                                                "total"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "links",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/notifications/batch": {
            "post": {
                "operationId": "notification.storeBatch",
                "tags": [
                    "Notification"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreNotificationBatchRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/notifications/{notification}": {
            "get": {
                "operationId": "notification.show",
                "tags": [
                    "Notification"
                ],
                "parameters": [
                    {
                        "name": "notification",
                        "in": "path",
                        "required": true,
                        "description": "The notification ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`NotificationResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/NotificationResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/v1/batches/{batch}": {
            "get": {
                "operationId": "notification.showBatch",
                "tags": [
                    "Notification"
                ],
                "parameters": [
                    {
                        "name": "batch",
                        "in": "path",
                        "required": true,
                        "description": "The batch ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "batch_id": {
                                                    "type": "string"
                                                },
                                                "total_count": {
                                                    "type": "integer"
                                                },
                                                "status_counts": {
                                                    "type": "string"
                                                },
                                                "created_at": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "batch_id",
                                                "total_count",
                                                "status_counts",
                                                "created_at"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/v1/notifications/{notification}/cancel": {
            "post": {
                "operationId": "notification.cancel",
                "tags": [
                    "Notification"
                ],
                "parameters": [
                    {
                        "name": "notification",
                        "in": "path",
                        "required": true,
                        "description": "The notification ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`NotificationResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/NotificationResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Channel": {
                "type": "string",
                "enum": [
                    "sms",
                    "email",
                    "push"
                ],
                "title": "Channel"
            },
            "NotificationResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "idempotency_key": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "batch_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "channel": {
                        "$ref": "#/components/schemas/Channel"
                    },
                    "recipient": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "priority": {
                        "$ref": "#/components/schemas/Priority"
                    },
                    "status": {
                        "$ref": "#/components/schemas/NotificationStatus"
                    },
                    "attempts": {
                        "type": "integer"
                    },
                    "provider_message_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "last_error": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "scheduled_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "sent_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "failed_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "idempotency_key",
                    "batch_id",
                    "channel",
                    "recipient",
                    "content",
                    "priority",
                    "status",
                    "attempts",
                    "provider_message_id",
                    "last_error",
                    "scheduled_at",
                    "sent_at",
                    "failed_at",
                    "created_at"
                ],
                "title": "NotificationResource"
            },
            "NotificationStatus": {
                "type": "string",
                "enum": [
                    "pending",
                    "queued",
                    "processing",
                    "sent",
                    "failed",
                    "cancelled"
                ],
                "title": "NotificationStatus"
            },
            "Priority": {
                "type": "string",
                "enum": [
                    "high",
                    "normal",
                    "low"
                ],
                "title": "Priority"
            },
            "StoreNotificationBatchRequest": {
                "type": "object",
                "properties": {
                    "idempotency_key": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "notifications": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "idempotency_key": {
                                    "type": "string"
                                }
                            }
                        },
                        "minItems": 1,
                        "maxItems": 1000,
                        "uniqueItems": true
                    }
                },
                "required": [
                    "notifications"
                ],
                "title": "StoreNotificationBatchRequest"
            },
            "StoreNotificationRequest": {
                "type": "object",
                "properties": {
                    "channel": {
                        "$ref": "#/components/schemas/Channel"
                    },
                    "recipient": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "content": {
                        "type": "string",
                        "maxLength": 10000
                    },
                    "priority": {
                        "$ref": "#/components/schemas/Priority"
                    },
                    "scheduled_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "idempotency_key": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    }
                },
                "required": [
                    "channel",
                    "recipient",
                    "content"
                ],
                "title": "StoreNotificationRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}